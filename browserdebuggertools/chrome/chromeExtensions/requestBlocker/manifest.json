{
  "manifest_version": 3,
  "name": "Request Blocker",
  "description": "Request Blocker",
  "version": "1.0",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "windows",
    "alarms" // Used to keep/wake the service worker (self-healing keep-alive)
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "requestBlocker.js"
  }
}
